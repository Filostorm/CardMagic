{
  "name": "cardmagic",
  "version": "3.9.3",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --port 8082",
    "android": "expo run:android",
    "ios": "expo run:ios --port 8082",
    "web": "expo start --web --port 8082",
    "export:web": "expo export --platform web",
    "export:cloudflare": "npm run export:web && node scripts/prepare-cloudflare-pages.mjs",
    "predeploy:web": "npm run export:web",
    "deploy:web": "npx --yes eas-cli deploy --prod --export-dir dist",
    "deploy:cloudflare": "npm run export:cloudflare && npx --yes wrangler pages deploy dist --project-name cardmagic --branch main --commit-dirty=true",
    "update:cards": "node scripts/update-card-database.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.106.2",
    "expo": "~54.0.33",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-media-library": "~18.2.1",
    "expo-sensors": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "jszip": "^3.10.1",
    "lucide-react-native": "^1.14.0",
    "pdf-lib": "^1.17.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.10",
    "typescript": "~5.9.2"
  },
  "private": true
}
