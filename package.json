{
  "name": "cardmagic",
  "version": "3.38.6",
  "main": "index.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "expo start --port 8082",
    "android": "expo run:android",
    "ios": "expo run:ios --port 8082",
    "web": "expo start --web --port 8082",
    "clean:duplicates": "node scripts/clean-duplicate-artifacts.mjs",
    "export:web": "EXPO_USE_FAST_RESOLVER=1 WATCHMAN_DISABLE=1 expo export --platform web --max-workers 1 --clear --output-dir \"${CARDMAGIC_CLOUDFLARE_OUTPUT_DIR:-dist}\"",
    "export:cloudflare": "npm run clean:duplicates && node scripts/clean-cloudflare-output.mjs && npm run export:web && npm run clean:duplicates && node scripts/prepare-cloudflare-pages.mjs",
    "release:verify": "node scripts/verify-release-notes.mjs",
    "release:metadata": "node scripts/update-release-metadata.mjs",
    "predeploy:web": "npm run export:web",
    "deploy:cloudflare": "npm run deploy:cloudflare:beta",
    "deploy:cloudflare:beta": "node scripts/deploy-cloudflare-pages.mjs beta",
    "deploy:cloudflare:production": "node scripts/deploy-cloudflare-pages.mjs production",
    "update:cards": "node scripts/update-card-database.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.106.2",
    "expo": "~54.0.35",
    "expo-asset": "~12.0.13",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-media-library": "~18.2.1",
    "expo-sensors": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.1",
    "lucide-react-native": "^1.14.0",
    "pdf-lib": "^1.17.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.8.3"
  },
  "devDependencies": {
    "@expo/cli": "^54.0.25",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.10",
    "json5": "^2.2.3",
    "typescript": "~5.9.2",
    "vitest": "^4.1.8"
  },
  "private": true
}
